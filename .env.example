# Teable (single source of truth — replaces Supabase + TinyTalk)
# TEABLE_TOKEN is server-only; never create VITE_TEABLE_TOKEN
TEABLE_BASE_URL=https://app.teable.ai/api
TEABLE_TOKEN=teable_your_personal_access_token_here
TEABLE_BASE_ID=bseycH4L66iLE60akaY

# Table IDs (get from Teable UI → Table → Copy Table ID)
# Frontend-readable (VITE_ prefixed) — public identifiers safe for browser
VITE_TEABLE_BASE_URL=https://app.teable.ai/api
VITE_TEABLE_BASE_ID=bseycH4L66iLE60akaY
VITE_TEABLE_TABLE_RESTAURANT_SECRETS=tblYj4UR61kOGZW39VD
VITE_TEABLE_TABLE_BLACKOUT_PERIODS=tblpD9jaeiLatvcxrW5
VITE_TEABLE_TABLE_RESERVATIONS=tblS9D2no6IRzjBR8GF
VITE_TEABLE_TABLE_MENU_ITEMS=tblA7clUw5kQZvM0tq2
VITE_TEABLE_TABLE_CHAT_LOGS=tblysXQ6DKT7NMioufw
VITE_TEABLE_TABLE_REVIEWS=tbl58tvSxiKduCiBUgW
VITE_TEABLE_TABLE_PROFILES=tblTEzmTnxhK1T1LKhX
VITE_TEABLE_TABLE_STAFF_MEMBERS=tblZx2jtPOuczEnO1Hn
VITE_TEABLE_TABLE_FACTURA_REQUESTS=tblW49Fm4oUXXRrfAvA
VITE_TEABLE_TABLE_CHATBOT_RULES=tbl1989NJeU5Je64Olj

# Server-only table IDs (no VITE_ prefix) — for backend/admin use
TEABLE_TABLE_ADMINS=tblXO8kQQQTgukqGKv7
TEABLE_TABLE_MENU_CATEGORIES=tblPNWKAItxTf7aZof0

# Admin Portal
ADMIN_PASSWORD=change-me-before-going-live

# AI Concierge (Gemini/OpenAI fallback — no TinyTalk)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here

# Email (Resend)
RESEND_API_KEY=re_your_resend_key_here

# Optional: FreeLLM API proxy for model fallback
FREELLMAPI_URL=

# Storage for Factura uploads (choose one)
# Option 1: Cloudinary (unsigned upload)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Option 2: AWS S3 (requires AWS SDK - add @aws-sdk/client-s3 to package.json)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=your_bucket_name

# Option 3: n8n webhook for base64 processing
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/factura-upload

# Option 4: Fallback - base64 data URLs (not recommended for production)
# FACTURA_STORAGE_MODE=base64